;-------------------------------------------------------------------------------
; ECE 2560 Final Exam Part 1
;
; Name:
;-------------------------------------------------------------------------------
            .cdecls C,LIST,"msp430.h"       ; Include device header file
            
;-------------------------------------------------------------------------------
            .def    RESET                   ; Export program entry-point to
                                            ; make it known to linker.
;-------------------------------------------------------------------------------
            .text                           ; Assemble into program memory.
            .retain                         ; Override ELF conditional linking
                                            ; and retain current section.
            .retainrefs                     ; And retain any sections that have
                                            ; references to current section.
;-------------------------------------------------------------------------------
RESET       mov.w   #__STACK_END,SP         ; Initialize stackpointer
StopWDT     mov.w   #WDTPW|WDTHOLD,&WDTCTL  ; Stop watchdog timer
;-------------------------------------------------------------------------------
; Main loop here
;-------------------------------------------------------------------------------
; Initialize GPIO for LEDs
            bis.b   #BIT0, &P1DIR           ; P1.0 (Red LED) as output
            bic.b   #BIT0, &P1OUT           ; Red LED off initially
            bis.b   #BIT7, &P9DIR           ; P9.7 (Green LED) as output
            bic.b   #BIT7, &P9OUT           ; Green LED off initially

; Initialize state variable
            mov.b   #0, R4                  ; R4 holds state (0-7)

; Configure Timer B0 to raise interrupts
			bis.w	#TBCLR, &TB0CTL
			bis.w	#TBSSEL__ACLK, &TB0CTL		; connected to ACLK
			bis.w	#MC__CONTINUOUS, &TB0CTL	; continuous mode
			bis.w	#CNTL__12, &TB0CTL			; counter length = 12 bits
			bis.w	#ID__4, &TB0CTL				; input divider
			bis.w	#TBIE, &TB0CTL 				; enable interrupts

; Enable global interrupts
            nop
            bis.w   #GIE, SR                ; Enable global interrupts
            nop

; Enter LPM3
Mainloop:   bis.w   #LPM3, SR               ; Enter LPM3
            nop
            jmp     Mainloop

;-------------------------------------------------------------------------------
; Interrupt Service Routine
;-------------------------------------------------------------------------------
Timer_B0_ISR:
            ; Test and clear TBIFG only
            bit.w   #TBIFG, &TB0CTL         ; Test TBIFG
            jz      ISR_Exit                ; If not set, exit
            bic.w   #TBIFG, &TB0CTL         ; Clear TBIFG only

            ; State machine implementation
            ; States: 0=Red1 ON, 1=OFF, 2=Red2 ON, 3=OFF,
            ;         4=Green1 ON, 5=OFF, 6=Green2 ON, 7=OFF

            cmp.b   #0, R4
            jeq     State0
            cmp.b   #1, R4
            jeq     State1
            cmp.b   #2, R4
            jeq     State2
            cmp.b   #3, R4
            jeq     State3
            cmp.b   #4, R4
            jeq     State4
            cmp.b   #5, R4
            jeq     State5
            cmp.b   #6, R4
            jeq     State6
            jmp     State7

State0:     ; Red LED ON
            bis.b   #BIT0, &P1OUT           ; Turn on red LED
            bic.b   #BIT7, &P9OUT           ; Ensure green is off
            inc.b   R4                      ; Next state
            jmp     ISR_Exit

State1:     ; OFF
            bic.b   #BIT0, &P1OUT           ; Turn off red LED
            bic.b   #BIT7, &P9OUT           ; Turn off green LED
            inc.b   R4                      ; Next state
            jmp     ISR_Exit

State2:     ; Red LED ON (second time)
            bis.b   #BIT0, &P1OUT           ; Turn on red LED
            bic.b   #BIT7, &P9OUT           ; Ensure green is off
            inc.b   R4                      ; Next state
            jmp     ISR_Exit

State3:     ; OFF
            bic.b   #BIT0, &P1OUT           ; Turn off red LED
            bic.b   #BIT7, &P9OUT           ; Turn off green LED
            inc.b   R4                      ; Next state
            jmp     ISR_Exit

State4:     ; Green LED ON
            bic.b   #BIT0, &P1OUT           ; Ensure red is off
            bis.b   #BIT7, &P9OUT           ; Turn on green LED
            inc.b   R4                      ; Next state
            jmp     ISR_Exit

State5:     ; OFF
            bic.b   #BIT0, &P1OUT           ; Turn off red LED
            bic.b   #BIT7, &P9OUT           ; Turn off green LED
            inc.b   R4                      ; Next state
            jmp     ISR_Exit

State6:     ; Green LED ON (second time)
            bic.b   #BIT0, &P1OUT           ; Ensure red is off
            bis.b   #BIT7, &P9OUT           ; Turn on green LED
            inc.b   R4                      ; Next state
            jmp     ISR_Exit

State7:     ; OFF
            bic.b   #BIT0, &P1OUT           ; Turn off red LED
            bic.b   #BIT7, &P9OUT           ; Turn off green LED
            mov.b   #0, R4                  ; Reset to state 0
            ; Fall through to ISR_Exit

ISR_Exit:
            reti

;-------------------------------------------------------------------------------
; Stack Pointer definition
;-------------------------------------------------------------------------------
            .global __STACK_END
            .sect   .stack
;-------------------------------------------------------------------------------
; Interrupt Vectors
;-------------------------------------------------------------------------------
            .sect   ".reset"                ; MSP430 RESET Vector
            .short  RESET

            .sect   ".int43"                ; Timer B0 vector at 0xFFF4
            .short  Timer_B0_ISR
