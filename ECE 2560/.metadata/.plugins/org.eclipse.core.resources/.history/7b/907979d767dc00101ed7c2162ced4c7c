            .cdecls C,LIST,"msp430.h"       ; Include device header file

;-------------------------------------------------------------------------------
            .def    RESET                   ; Export program entry-point to
                                            ; make it known to linker.
;-------------------------------------------------------------------------------
            .text                           ; Assemble into program memory.
            .retain                         ; Override ELF conditional linking
                                            ; and retain current section.
            .retainrefs                     ; And retain any sections that have
                                            ; references to current section.
;-------------------------------------------------------------------------------
RESET       mov.w   #__STACK_END,SP         ; Isnitialize stackpointer
StopWDT     mov.w   #WDTPW|WDTHOLD,&WDTCTL  ; Stop watchdog timer
;-------------------------------------------------------------------------------
; Main loop here
;-------------------------------------------------------------------------------
            ; Disable the GPIO power-on default high-impedance mode
            bic.w   #LOCKLPM5, &PM5CTL0

            ; Configure red LED on P1.0
            bis.b   #BIT0, &P1DIR
            bis.b   #BIT0, &P1OUT     			; Start ON (set bit = LED on)

            ; Configure green LED on P9.7
            bis.b   #BIT7, &P9DIR
            bic.b   #BIT7, &P9OUT       		; Start OFF (clear bit = LED off)

            ; Initialize state variable
            mov.b   #0, R4                  	; R4 holds state (0-7)

; Configure Timer B0 to raise interrupts
            bis.w    #TBCLR, &TB0CTL
            bis.w    #TBSSEL__ACLK, &TB0CTL   	; connected to ACLK
            bis.w    #MC__CONTINUOUS, &TB0CTL  	; continuous mode
            bis.w    #CNTL__12, &TB0CTL       	; counter length = 12 bits
            bis.w    #ID__4, &TB0CTL        	; input divider
            bis.w    #TBIE, &TB0CTL        		; enable interrupts

            ; Enter Low Power Mode 3 with interrupts enabled
            nop                          		; Required before setting GIE
            bis.w   #GIE|LPM3, SR
            nop                                 ; CPU resumes here after interrupt
;-------------------------------------------------------------------------------
; Interrupt Service Routine
;-------------------------------------------------------------------------------
Timer_B0_ISR:
        bic.w   #TBIFG, &TB0CTL                 ; Test and clear

        ;xor.b   #BIT0, &P1OUT                   ; Toggle red
        ;xor.b   #BIT7, &P9OUT                   ; Toggle green

            ; State machine implementation
            ; States: 0=Red1 ON, 1=OFF, 2=Red2 ON, 3=OFF,
            ;         4=Green1 ON, 5=OFF, 6=Green2 ON, 7=OFF

            jmp     red_Toggle					; Red OFF
            jmp     red_Toggle					; Red ON
            jmp		red_Toggle					; Red OFF
            jmp 	green_Toggle				; Green ON
            jmp 	green_Toggle				; Green OFF
            jmp 	green_Toggle				; Green ON
            jmp 	green_Toggle				; Green OFF

 red_Toggle:
 			bis.b   #BIT0, &P1OUT           	; Toggle Red
            jmp     ret_ISR

 green_Toggle:
 			bis.b	#BIT7, &P9OUT				; Toggle Green
 			jmp 	ret_ISR

 ret_ISR:
 			reti
;-------------------------------------------------------------------------------
; Stack Pointer definition
;-------------------------------------------------------------------------------
            .global __STACK_END
            .sect   .stack
;-------------------------------------------------------------------------------
; Interrupt Vectors
;-------------------------------------------------------------------------------
            .sect 	".int50"
            .short 	Timer_B0_ISR

            .sect   ".reset"                ; MSP430 RESET Vector
            .short  RESET
